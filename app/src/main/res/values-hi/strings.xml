    <string name="guide_subtitle" formatted="false">अपने पसंदीदा वीडियो को बनाए रखने के लिए एक सरल मार्गदर्शिका।</string>
    <string name="step_one_title" formatted="false">अपना वीडियो ढूंढें</string>
    <string name="step_one_body" formatted="false">ब्राउज़ खोलें. वेबसाइट का पता खोजें या दर्ज करें. आप किसी अन्य ऐप से वीडियो लिंक भी साझा कर सकते हैं।</string>
    <string name="step_two_title" formatted="false">स्रोत की खोज करें</string>
    <string name="step_two_body" formatted="false">एक वीडियो चलाएं, फिर वीडियो ढूंढें पर टैप करें। पता लगाई गई फ़ाइल चुनें, या सीधा HTTPS वीडियो लिंक पेस्ट करें।</string>
    <string name="step_three_title" formatted="false">इसे अपना बनाओ</string>
    <string name="step_three_body" formatted="false">एक फ़ाइल नाम चुनें, वीडियो को सहेजने के लिए अपनी अनुमति की पुष्टि करें और डाउनलोड पर टैप करें। एंड्रॉइड पृष्ठभूमि में डाउनलोड जारी रखता है।</string>
    <string name="step_four_title" formatted="false">अपने संग्रह का आनंद लें</string>
    <string name="step_four_body" formatted="false">प्रगति जांचने के लिए डाउनलोड खोलें। पूर्ण वीडियो चलाएं या साझा करें. आवश्यकता पड़ने पर एक नए लिंक के साथ विफल डाउनलोड का पुनः प्रयास करें।</string>
    <string name="try_now" formatted="false">इसे अभी आज़माएं</string>
