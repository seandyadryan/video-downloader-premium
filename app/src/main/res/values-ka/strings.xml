    <string name="step_one_title" formatted="false">იპოვეთ თქვენი ვიდეო</string>
    <string name="step_one_body" formatted="false">გახსენით დათვალიერება. მოძებნეთ ან შეიყვანეთ ვებსაიტის მისამართი. თქვენ ასევე შეგიძლიათ გააზიაროთ ვიდეო ბმული სხვა აპიდან.</string>
    <string name="step_two_title" formatted="false">აღმოაჩინეთ წყარო</string>
    <string name="step_two_body" formatted="false">დაუკარით ვიდეო, შემდეგ შეეხეთ ვიდეოების ძებნას. აირჩიეთ აღმოჩენილი ფაილი ან ჩასვით პირდაპირი HTTPS ვიდეო ბმული.</string>
    <string name="step_three_title" formatted="false">გახადე შენი</string>
    <string name="step_three_body" formatted="false">აირჩიეთ ფაილის სახელი, დაადასტურეთ ვიდეოს შენახვის ნებართვა და შეეხეთ ჩამოტვირთვა. Android აგრძელებს ჩამოტვირთვას ფონზე.</string>
    <string name="step_four_title" formatted="false">ისიამოვნეთ თქვენი კოლექციით</string>
    <string name="step_four_body" formatted="false">პროგრესის შესამოწმებლად გახსენით ჩამოტვირთვები. დასრულებული ვიდეოების დაკვრა ან გაზიარება. საჭიროების შემთხვევაში ხელახლა სცადეთ წარუმატებელი ჩამოტვირთვები ახალი ბმულით.</string>
